config_version=5

[application]

config/name="UPT"
run/main_scene="uid://b2rmg3s2lx41a"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://Art/Other/icon.svg"

[autoload]

PhantomCameraManager="*uid://duq6jhf6unyis"
Dialogic="*uid://ds2q0uclmolvu"

[dialogic]

directories/dch_directory={}
directories/dtl_directory={}
layout/style_directory={}

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogic/plugin.cfg", "res://addons/phantom_camera/plugin.cfg")

